pairs(data_num)
# Macierz korelacji
cor_matrix <- round(cor(data_num), 2)
print(cor_matrix)
# Heatmapa korelacji
cor_melted <- melt(cor_matrix)
ggplot(data = cor_melted, aes(x = Var1, y = Var2, fill = value)) +
